if [ -d "$HOME/.config/rc/pre" ]; then 
    for f in "$HOME/.config/rc/pre"/*.sh; do
        [ -f "$f" ] && source "$f"
    done
fi

export GPG_TTY=$(tty)
eval "$(ssh-agent -s)" > /dev/null

export MANPATH="$MANPATH:${HOME}/.local/share/man"

powerline-daemon -q
POWERLINE_BASH_CONTINUATION=1
POWERLINE_BASH_SELECT=1
if command -v uv >/dev/null 2>&1; then
    # bindings ship as package data in the tool venv's site-packages, not bin/
    for POWERLINE_BINDINGS in "$(uv tool dir)"/powerline-status/lib/python3*/site-packages/powerline/bindings/bash/powerline.sh; do
        [ -f "$POWERLINE_BINDINGS" ] && source "$POWERLINE_BINDINGS" && break
    done
fi
if [ -z "${POWERLINE_COMMAND:-}" ] && command -v powerline-daemon >/dev/null 2>&1; then
    _powerline_prefix="$(dirname "$(dirname "$(readlink -f "$(command -v powerline-daemon)")")")"
    if [ -f "$_powerline_prefix/share/bash/powerline.sh" ]; then
        source "$_powerline_prefix/share/bash/powerline.sh"
    fi
    unset _powerline_prefix
fi

# dotdrop only accepts --cfg after the subcommand, so point it at the repo config via env var.
# DOTFILES_DIR is recorded on first install by the persist_dotfiles_dir action (rc/pre/00-dotfiles.sh).
alias dotdrop='DOTDROP_CONFIG="${DOTFILES_DIR:-$HOME/dotfiles}/config.yaml" dotdrop'

rgf() {
    # no quotes around @ expansion because search patterns and escapes
    path=""
    rest=$@
    if [[ -d $1 ]]; then
        path="$1"
        rest=${@:2}
    fi
    rg --files $path | rg $rest
}

func() {
    type $1 | tail -n+2 | bat -l bash
}

# load any other scripts
if [ -d "$HOME/.config/rc" ]; then
    for f in "$HOME/.config/rc"/*.sh; do 
        [ -f "$f" ] && source "$f"
    done
fi

