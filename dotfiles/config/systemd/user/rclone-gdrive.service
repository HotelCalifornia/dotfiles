[Unit]
Description=rclone mount: Google Drive (gdrive:) -> ~/GoogleDrive
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/bin/rclone mount gdrive: %h/GoogleDrive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 10G \
  --vfs-cache-max-age 24h \
  --dir-cache-time 5m \
  --poll-interval 1m \
  --drive-export-formats docx,xlsx,pptx,svg \
  --log-level INFO \
  --log-file %h/.cache/rclone/gdrive-mount.log
ExecStop=/usr/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
